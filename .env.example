# CodeLens — copy to .env and adjust

# PostgreSQL
DB_NAME=codelens
DB_USER=codelens
DB_PASSWORD=codelens
DB_PORT=5432
DATABASE_URL=

# CloudAMQP (required for job queue — https://www.cloudamqp.com/)
RABBITMQ_URL=amqps://user:pass@host/vhost

# Optional discrete RabbitMQ settings (used when RABBITMQ_URL is unset)
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PREFETCH=1

JWT_SECRET=change-me-to-a-long-random-secret-for-production

FILE_WORKERS=4
WORKER_MAX_RETRIES=3
WORKER_ID=worker-1

# Ops Agent brain (prefer free Gemini; OpenAI optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPS_AGENT_PREFER_GEMINI=true
OPENAI_API_KEY=
OPS_AGENT_PREFER_OPENAI=false
OPENAI_MODEL=gpt-4o-mini

BACKEND_PORT=8080
FRONTEND_PORT=3000
