# CodeLens — copy to .env and adjust

# PostgreSQL
DB_NAME=codelens
DB_USER=codelens
DB_PASSWORD=codelens
DB_PORT=5432
DATABASE_URL=

# CloudAMQP (required for job queue — https://www.cloudamqp.com/)
RABBITMQ_URL=amqps://user:pass@host/vhost

# Optional discrete RabbitMQ settings (used when RABBITMQ_URL is unset)
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PREFETCH=1

JWT_SECRET=change-me-to-a-long-random-secret-for-production

FILE_WORKERS=4
WORKER_MAX_RETRIES=3
WORKER_ID=worker-1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Public URLs (required for OAuth redirects)
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Google OAuth (Gmail) — https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook) — https://portal.azure.com/ → App registrations
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Welcome email (SMTP). Set MAIL_ENABLED=true when ready.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@codelens.app
MAIL_FROM_NAME=CodeLens
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
